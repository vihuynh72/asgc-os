# Required Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Application appearance
DESIGN_DEFAULT=v2

# Scheduled jobs, use at least 16 random characters
CRON_SECRET=replace-with-a-long-random-secret

# Email through Resend
EMAIL_PROVIDER=resend
EMAIL_FROM=ASGC OS <notifications@example.org>
RESEND_API_KEY=replace-with-resend-api-key

# SMS through Twilio
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=replace-with-twilio-messaging-service-sid
OFFICE_HOURS_KIOSK_OTP_SECRET=replace-with-a-long-random-otp-secret

# Optional AI document helpers
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=

# Optional input for `npm run bootstrap:president`, set explicitly before use
ASGC_PRESIDENT_EMAIL=
